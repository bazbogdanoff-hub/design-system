    "popover": { "$value": "{radius.panel}" },
    "button": {
      "secondary": {
        "sm": { "$value": "{radius.chip}", "$description": "6 — ~28px tall" },
        "md": { "$value": "{radius.control}", "$description": "8 — ~32" },
