{
  "color": {
    "button": {
      "primary": {
        "background": {
          "default": {
            "$value": "{color.brand.400}",
            "$description": "Primary button fill — a lightened brand. Button-only gimmick: color.text.brand / color.icon.brand stay at 600 everywhere else."
          },
          "hover": {
            "$value": "{color.brand.500}"
          }
        },
        "text": {
          "$value": "{color.text.on-brand}"
        },
        "icon": {
          "$value": "{color.icon.on-brand}"
        },
        "border": {
          "default": {
            "$value": "#aab1f9",
            "$description": "Glass catch on the coloured primary surface — hand-tuned, not on the palette."
          },
          "hover": {
            "$value": "#7a85f8"
          }
        },
        "shadow": {
          "default": {
            "$value": "#6570e1",
            "$description": "Inner-shadow colour for the 'Viginette primary 2xs' effect style (hand-tuned)."
          },
          "hover": {
            "$value": "#4e51ed"
          }
        }
      },
      "secondary": {
        "background": {
          "default": {
            "$value": "{color.card.background.default}",
            "$description": "Same glass surface as Card / StatButton — #fcfcfc, unchanged by state (hover swaps the shadow, not the fill)."
          }
        },
        "text": {
          "$value": "{color.text.strong}"
        },
        "icon": {
          "$value": "{color.icon.default}"
        },
        "border": {
          "default": {
            "$value": "{color.card.border}",
            "$description": "White glass catch (top + left) at rest / hover."
          },
          "active": {
            "$value": "{color.card.border-active}",
            "$description": "Full 1.5px primary border on focus / active."
          }
        }
      },
      "ghost": {
        "background": {
          "default": {
            "$value": "transparent"
          },
          "hover": {
            "$value": "{color.background.brand-subtle}"
          },
          "active": {
            "$value": "{color.background.brand-subtle}"
          }
        },
        "text": {
          "$value": "{color.text.brand}"
        }
      },
      "danger": {
        "background": {
          "default": {
            "$value": "{color.background.danger.default}"
          },
          "hover": {
            "$value": "{color.background.danger.hover}"
          }
        },
        "text": {
          "$value": "{color.text.on-danger}"
        }
      },
      "disabled": {
        "background": {
          "$value": "{color.background.disabled}"
        },
        "text": {
          "$value": "{color.text.disabled}"
        }
      }
    },
    "card": {
      "background": {
        "default": {
          "$value": "{color.surface.card}"
        },
        "hover": {
          "$value": "{color.surface.subtle}",
          "$description": "Reserved — for the future interactive-card hover state (not used yet)"
        }
      },
      "border": {
        "$value": "{color.border.highlight}",
        "$description": "The asymmetric glass catch (top + left, 1.5px, white). Widths + the inner-shadow are hand-tuned in the CSS, not tokens."
      },
      "border-active": {
        "$value": "{color.border.highlight-active}",
        "$description": "Focused/active glass border — full 1.5px primary, replaces the white top-left catch. Shared by Card, StatButton, and other glass buttons."
      }
    },
    "input": {
      "background": {
        "default": {
          "$value": "{color.surface.default}"
        },
        "disabled": {
          "$value": "{color.background.disabled}"
        }
      },
      "text": {
        "$value": "{color.text.default}"
      },
      "placeholder": {
        "$value": "{color.text.muted}"
      },
      "label": {
        "$value": "{color.text.subtle}"
      },
      "border": {
        "default": {
          "$value": "{color.border.default}"
        },
        "hover": {
          "$value": "{color.border.strong}"
        },
        "focus": {
          "$value": "{color.border.focus}"
        },
        "danger": {
          "$value": "{color.border.danger}"
        }
      }
    },
    "badge": {
      "neutral": {
        "background": {
          "$value": "{color.background.subtle}"
        },
        "text": {
          "$value": "{color.text.subtle}"
        }
      },
      "brand": {
        "background": {
          "$value": "{color.background.brand-subtle}"
        },
        "text": {
          "$value": "{color.text.brand}"
        }
      },
      "success": {
        "background": {
          "$value": "{color.background.success-subtle}"
        },
        "text": {
          "$value": "{color.text.success}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.background.warning-subtle}"
        },
        "text": {
          "$value": "{color.amber.600}",
          "$description": "One step lighter than text.warning (amber.700) — deliberate primitive alias so the amber `warning` badge is clearly distinct from the orange `warning-strong` badge. Small contrast tradeoff (~3.2:1) accepted for level differentiation."
        }
      },
      "warning-strong": {
        "background": {
          "$value": "{color.background.warning-strong-subtle}"
        },
        "text": {
          "$value": "{color.text.warning-strong}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.background.danger-subtle}"
        },
        "text": {
          "$value": "{color.text.danger}"
        }
      },
      "info": {
        "background": {
          "$value": "{color.background.info-subtle}"
        },
        "text": {
          "$value": "{color.text.info}"
        }
      }
    },
    "table": {
      "header": {
        "background": {
          "$value": "{color.surface.subtle}"
        },
        "text": {
          "$value": "{color.text.subtle}"
        }
      },
      "row": {
        "background": {
          "default": {
            "$value": "{color.surface.default}"
          },
          "hover": {
            "$value": "{color.background.subtle}"
          },
          "selected": {
            "$value": "{color.background.brand-subtle}"
          }
        }
      },
      "border": {
        "$value": "{color.border.subtle}"
      }
    },
    "modal": {
      "background": {
        "$value": "{color.surface.raised}"
      },
      "border": {
        "$value": "{color.border.default}"
      },
      "scrim": {
        "$value": "{color.background.overlay}"
      }
    }
  }
}
